{
  "name": "@uploadcare/file-uploader-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo for @uploadcare/file-uploader and related packages",
  "type": "module",
  "workspaces": [
    "packages/file-uploader",
    "packages/adaptive-image",
    "packages/cloud-image-editor"
  ],
  "repository": {
    "type": "https",
    "url": "https://github.com/uploadcare/file-uploader"
  },
  "homepage": "https://uploadcare.com/",
  "license": "MIT",
  "author": "Uploadcare Inc.",
  "scripts": {
    "dev": "lerna run dev --stream",
    "build": "lerna run build --stream",
    "test": "lerna run test --stream",
    "lint": "lerna run lint --stream",
    "lint:js": "eslint .",
    "lint:js:fix": "eslint . --fix",
    "lint:css": "stylelint '**/*.css'",
    "lint:css:fix": "stylelint '**/*.css' --fix",
    "tsc": "lerna run tsc --stream",
    "format": "biome check --write",
    "prepare": "husky install",
    "playwright:install": "lerna run playwright:install --stream",
    "version": "lerna version",
    "release": "lerna publish from-git",
    "release:from-package": "lerna publish from-package"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.6",
    "@size-limit/preset-small-lib": "^12.0.1",
    "eslint": "^10.0.3",
    "eslint-plugin-lit": "^2.2.1",
    "eslint-plugin-wc": "^3.1.0",
    "husky": "^9.1.7",
    "lerna": "^9.0.3",
    "lint-staged": "^16.3.3",
    "npm-run-all": "^4.1.5",
    "nx": "^21.0.0",
    "rimraf": "^6.1.3",
    "size-limit": "^12.0.1",
    "stylelint": "^17.4.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-declaration-block-no-ignored-properties": "^3.0.0",
    "stylelint-order": "^8.0.0",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.0"
  }
}
