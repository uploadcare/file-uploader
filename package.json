{
  "name": "@uploadcare/file-uploader-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo for @uploadcare/file-uploader and related packages",
  "type": "module",
  "workspaces": [
    "packages/file-uploader",
    "packages/adaptive-image",
    "packages/cloud-image-editor"
  ],
  "repository": {
    "type": "https",
    "url": "https://github.com/uploadcare/file-uploader"
  },
  "homepage": "https://uploadcare.com/",
  "license": "MIT",
  "author": "Uploadcare Inc.",
  "scripts": {
    "dev": "lerna run dev --stream",
    "build": "lerna run build --stream",
    "test": "lerna run test --stream",
    "lint": "lerna run lint --stream",
    "format": "biome check --write",
    "prepare": "husky install",
    "playwright:install": "lerna run playwright:install --stream"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.6",
    "husky": "^9.1.7",
    "lerna": "^9.0.3",
    "lint-staged": "^16.3.3",
    "nx": "^21.0.0"
  }
}
