{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react",
    "types": ["@total-typescript/ts-reset", "@vitest/browser-playwright", "vite/client"],
    "jsxFactory": "renderer.create",
    "jsxFragmentFactory": "renderer.fragment",
    "allowJs": true,
    "paths": {
      "@/*": ["./src/*"],
      "~/*": ["./*"]
    }
  },
  "include": ["src", "tests"],
  "exclude": ["node_modules", "**/*.test.js"]
}
