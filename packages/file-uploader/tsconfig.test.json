{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "lib": ["ESNext", "ESNext.Array", "DOM", "DOM.Iterable"],
    "types": ["node", "vitest", "@total-typescript/ts-reset", "./types/jsx.d.ts", "vite/client"],
    "allowJs": true,
    "paths": {
      "@/*": ["./src/*"],
      "~/*": ["./*"]
    }
  },
  "include": ["src", "types/test", "./**/*.test.ts", "./**/*.test-d.tsx"],
  "exclude": ["node_modules"]
}
