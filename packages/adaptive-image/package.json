{
  "name": "@uploadcare/adaptive-image",
  "version": "1.0.0",
  "description": "Adaptive image web component (<uc-img>) for Uploadcare CDN — responsive, lazy-loaded, transformation-aware",
  "keywords": [
    "uploadcare",
    "adaptive image",
    "responsive image",
    "uc-img",
    "image optimization",
    "smart cdn",
    "webp",
    "avif",
    "web components",
    "custom elements",
    "lit"
  ],
  "type": "module",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./web/*": "./web/*"
  },
  "repository": {
    "type": "https",
    "url": "https://github.com/uploadcare/file-uploader",
    "directory": "packages/adaptive-image"
  },
  "homepage": "https://uploadcare.com/",
  "files": [
    "{dist,web}/**/*.{js,css,d.ts,d.ts.map,txt}",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build:lib": "npm run clean && tsx ./scripts/build.ts",
    "build": "npm run build:lib && npm run lint:size",
    "clean": "rimraf './dist/' './web/'",
    "dev": "tsx ./scripts/build.ts --watch",
    "lint:size": "size-limit",
    "lint": "biome lint",
    "test": "echo \"no tests yet\" && exit 0"
  },
  "dependencies": {
    "lit": "^3.3.2"
  },
  "devDependencies": {
    "@size-limit/preset-small-lib": "^12.0.1",
    "rimraf": "^6.1.3",
    "size-limit": "^12.0.1",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "author": "Uploadcare Inc.",
  "license": "MIT",
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "10 KB"
    },
    {
      "path": "web/uc-img.min.js",
      "limit": "10 KB"
    }
  ]
}
