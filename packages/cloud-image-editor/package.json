{
  "name": "@uploadcare/cloud-image-editor",
  "version": "1.0.0",
  "description": "Cloud image editor web component (<uc-cloud-image-editor>) for Uploadcare — crop, filters, rotations served from the Uploadcare CDN",
  "keywords": [
    "uploadcare",
    "cloud image editor",
    "image editor",
    "image editing",
    "uc-cloud-image-editor",
    "crop",
    "filters",
    "smart cdn",
    "web components",
    "custom elements",
    "lit"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./index.css": "./dist/index.css",
    "./web/*": "./web/*"
  },
  "repository": {
    "type": "https",
    "url": "https://github.com/uploadcare/file-uploader",
    "directory": "packages/cloud-image-editor"
  },
  "homepage": "https://uploadcare.com/",
  "files": [
    "{dist,web}/**/*.{js,css,d.ts,d.ts.map,txt}",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build:lib": "npm run clean && tsx ./scripts/build.ts",
    "build": "npm run build:lib && npm run lint:size",
    "clean": "rimraf './dist/' './web/'",
    "dev": "tsx ./scripts/build.ts --watch",
    "lint:size": "size-limit",
    "lint": "biome lint",
    "test": "echo \"no tests yet\" && exit 0"
  },
  "dependencies": {
    "@uploadcare/file-uploader": "^1.29.1",
    "lit": "^3.3.2"
  },
  "devDependencies": {
    "@size-limit/preset-small-lib": "^12.0.1",
    "rimraf": "^6.1.3",
    "size-limit": "^12.0.1",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "author": "Uploadcare Inc.",
  "license": "MIT",
  "size-limit": [
    {
      "path": "web/uc-cloud-image-editor.min.js",
      "limit": "50 KB"
    }
  ]
}
