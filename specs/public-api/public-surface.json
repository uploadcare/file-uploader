  "knownMissing": {
    "methods": {
      "navigate": "Documented in api.mdx as 'New in v1.34'; absent from UploaderPublicApi. package.json is 1.33.2, so either the docs are ahead of the release or it landed only on a v2 branch. Needs a human decision — do not add a shim to make a test pass."
    },
    "activityTypes": {
      "details": "Listed in the documented ActivityType union for navigate(); absent from ACTIVITY_TYPES in src/lit/activity-constants.ts."
    }
  },
  "knownMismatch": {
    "multipleMax": {
      "documented": 0,
      "actual": 9007199254740991,
      "note": "Docs say `0` — 'means no limit'; initialConfig.ts:14 uses Number.MAX_SAFE_INTEGER. Both behave as no-limit (validateMultiple treats 0 as falsy), so only the documented literal is wrong."
    },
    "retryThrottledRequestMaxTimes": {
      "documented": 10,
      "actual": 3,
      "note": "Docs say `10`; initialConfig.ts:47 is `3`. A real behavioural difference from what the docs promise."
    },
    "enableVideoRecording": {
      "documented": true,
      "actual": null,
      "note": "Docs say `true`; initialConfig.ts:77 is `null`. The option is deprecated in favour of `cameraModes`, and `null` reads as 'unset, derive from cameraModes' — a tri-state the docs do not describe."
    },
    "cdnCname": {
      "documented": "https://:subdomain.ucarecd.net",
      "actual": "https://ucarecdn.com",
      "note": "Not a bug: the docs give the *resolved* CNAME for new accounts, which is computed asynchronously from the pubkey (Config/computed-properties.ts). initialConfig.ts holds the pre-resolution literal. Resolution itself is covered by tests/config.e2e.test.tsx."
    }
  },
